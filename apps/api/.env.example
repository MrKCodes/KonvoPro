# Konvo API gateway environment template.
#
# Copy to apps/api/.env (gitignored) and fill in real values for local dev.
# Every variable below is parsed by apps/api/src/config.ts at boot. Missing or
# empty values cause the process to exit with status 1 BEFORE the listener
# opens (Requirements 17.6, 19.8).
#
# Lines flagged "REGENERATE FOR PRODUCTION" must NEVER be committed and must
# be replaced with freshly generated high-entropy secrets per environment.

# --- Runtime --------------------------------------------------------------

# 'development' | 'test' | 'production'. In production DATABASE_URL must
# include sslmode=require (enforced by config.ts).
NODE_ENV=development

# Fastify listening port. The container exposes this; Caddy reverse-proxies it.
PORT=3000

# --- Auth + token signing  (REGENERATE FOR PRODUCTION) --------------------

# HMAC secret for HS256 access tokens. >= 32 chars of high-entropy randomness.
# Generate: `openssl rand -base64 48`
JWT_ACCESS_SECRET=replace_me_with_at_least_32_chars_of_random_data____

# Server-side pepper hashed (sha256) into the refresh-token store. >= 32 chars.
# Generate: `openssl rand -base64 48`
REFRESH_TOKEN_PEPPER=replace_me_with_at_least_32_chars_of_random_data____

# --- Argon2id parameters (Requirement 1.1) --------------------------------
# Defaults match design.md: m=64 MiB, t=3, p=4. Override only with care; the
# boot benchmark must complete in >= 250 ms.
ARGON2_M_KIB=65536
ARGON2_T=3
ARGON2_P=4

# --- Postgres -------------------------------------------------------------

# Local docker-compose runs without TLS; production MUST include
# `sslmode=require` (Requirement 19.8). Production example:
#   postgres://konvo:STRONG@db.example.com:5432/konvo?sslmode=require
DATABASE_URL=postgres://konvo:konvo@postgres:5432/konvo?sslmode=disable

# --- Redis ----------------------------------------------------------------

# Use rediss:// for TLS in production.
REDIS_URL=redis://redis:6379

# --- MinIO (E2EE attachment ciphertext) -----------------------------------
# Endpoint is host:port without scheme. ACCESS/SECRET keys must be regenerated
# for production deployments.

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=konvo                          # REGENERATE FOR PRODUCTION
MINIO_SECRET_KEY=konvo_minio_password           # REGENERATE FOR PRODUCTION
MINIO_BUCKET=konvo-attachments
MINIO_USE_SSL=false

# --- VAPID (Web Push)  (REGENERATE FOR PRODUCTION) ------------------------
# Generate a fresh keypair via `npx web-push generate-vapid-keys`. The PWA
# embeds the public key; the private key MUST stay server-side. The subject
# must be a `mailto:` URI or `https://` URL identifying the operator.

VAPID_PUBLIC_KEY=replace_me_base64url_p256_public_key_at_least_80_chars__________
VAPID_PRIVATE_KEY=replace_me_base64url_p256_private_key_at_least_40_chars
VAPID_SUBJECT=mailto:ops@konvo.local

# --- LiveKit (broadcast SFU only)  (REGENERATE FOR PRODUCTION) ------------
# Used exclusively for broadcast rooms; never for 1:1 calls.

LIVEKIT_API_KEY=replace_me_livekit_api_key
LIVEKIT_API_SECRET=replace_me_livekit_secret_at_least_32_chars___
LIVEKIT_URL=ws://livekit:7880   # use wss:// in production

# --- coturn (TURN_Credentials)  (REGENERATE FOR PRODUCTION) ---------------
# REST auth secret used to sign ephemeral TURN usernames/passwords (1h TTL).
# Realm should match the public hostname in production.

COTURN_REST_SECRET=replace_me_with_at_least_32_chars_of_random_data
COTURN_REALM=konvo.local
