# Konvo API gateway environment template.
#
# Copy to apps/api/.env (gitignored) and use as-is for local dev.
# Every variable below is parsed by apps/api/src/config.ts at boot.
# Missing or short values cause the process to exit with status 1
# BEFORE the listener opens (Requirements 17.6, 19.8).
#
# Lines flagged "REGENERATE FOR PRODUCTION" must NEVER be committed
# and must be replaced with freshly generated high-entropy secrets
# per environment.

# --- Runtime --------------------------------------------------------------
# 'development' | 'test' | 'production'. In production DATABASE_URL must
# include sslmode=require (enforced by config.ts).
NODE_ENV=development

# Fastify listening port. The container exposes this; Caddy reverse-proxies it.
PORT=3000

# --- Auth + token signing  (REGENERATE FOR PRODUCTION) --------------------
# HMAC secret for HS256 access tokens. >= 32 chars of high-entropy randomness.
# Generate: `openssl rand -base64 48`
JWT_ACCESS_SECRET=devonly_jwt_access_secret_at_least_32_chars_of_padding_xxxxxxxxxxxx

# Server-side pepper hashed (sha256) into the refresh-token store. >= 32 chars.
# Generate: `openssl rand -base64 48`
REFRESH_TOKEN_PEPPER=devonly_refresh_token_pepper_at_least_32_chars_of_padding_xxxxxxxxx

# --- Argon2id parameters (Requirement 1.1) --------------------------------
# Defaults match design.md: m=64 MiB, t=3, p=4. Override only with care; the
# boot benchmark must complete in >= 250 ms.
ARGON2_M_KIB=65536
ARGON2_T=3
ARGON2_P=4

# --- Postgres -------------------------------------------------------------
# When the api runs on the host (`pnpm -F @konvo/api dev`), point at the
# host port published by infra/docker-compose.override.yml (localhost:5432).
# When the api runs in docker, the compose `environment:` block overrides
# this with the intra-network DNS name `postgres`.
DATABASE_URL=postgres://konvo:konvo@localhost:5432/konvo?sslmode=disable

# --- Redis ----------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# --- MinIO (E2EE attachment ciphertext) -----------------------------------
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=konvo
MINIO_SECRET_KEY=konvo-dev-password
MINIO_BUCKET=konvo-attachments
MINIO_USE_SSL=false

# --- VAPID (Web Push) ------------------------------------------------------
# Dev-only key pair. Regenerate per deployment via:
#   `npx web-push generate-vapid-keys`
# The PWA embeds the public key; the private key MUST stay server-side.
VAPID_PUBLIC_KEY=BNHe7Y_nHyB4AqlXYXo4hdr7oukLvPn-Wvy3DTMfNOnSMgPQkkOqOdg9nOKIEIPc7Gsp6pGiGdyGHbCW_3AeLS4
VAPID_PRIVATE_KEY=Qz69Oezyzf83y3sNticrgaGWxVzMb0P7bpIlDiyMuzk
VAPID_SUBJECT=mailto:ops@konvo.local

# --- LiveKit (broadcast SFU only)  (REGENERATE FOR PRODUCTION) ------------
# Used exclusively for broadcast rooms; never for 1:1 calls.
LIVEKIT_API_KEY=APIdevdevdevdevdevdevdev
LIVEKIT_API_SECRET=devonly_livekit_api_secret_at_least_32_chars_of_padding_xxxxxxxxxx
# When the api runs in docker, the compose env override points this at
# ws://livekit:7880. The host value below is for `pnpm -F @konvo/api dev`.
LIVEKIT_URL=ws://localhost:7880

# --- coturn (TURN_Credentials)  (REGENERATE FOR PRODUCTION) ---------------
# REST auth secret used to sign ephemeral TURN usernames/passwords (1h TTL).
# Realm should match the public hostname in production.
COTURN_REST_SECRET=devonly_coturn_rest_secret_at_least_32_chars_of_padding_xxxxxxxxxx
COTURN_REALM=konvo.local
