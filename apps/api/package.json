{
  "name": "@konvo/api",
  "version": "0.0.0",
  "private": true,
  "description": "Konvo API gateway (Fastify on Node 20). Placeholder bootstrap with /health only.",
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.0",
    "@fastify/helmet": "^12.0.0",
    "@fastify/multipart": "^9.0.0",
    "@fastify/rate-limit": "^10.1.0",
    "@fastify/websocket": "^11.0.0",
    "@konvo/crypto": "workspace:*",
    "@konvo/protocol": "workspace:*",
    "livekit-server-sdk": "^2.15.0",
    "argon2": "^0.41.1",
    "fastify": "^5.0.0",
    "ioredis": "^5.4.1",
    "jose": "^5.9.6",
    "minio": "^8.0.0",
    "otplib": "^12.0.1",
    "@otplib/core": "^12.0.1",
    "pg": "^8.13.1",
    "pino": "^10.3.0",
    "prom-client": "^15.1.3",
    "web-push": "^3.6.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "@types/pg": "^8.11.10",
    "@types/web-push": "^3.6.4",
    "fast-check": "^3.23.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^4.1.0"
  }
}
