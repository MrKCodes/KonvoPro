# =============================================================================
# Node.js / TypeScript / pnpm (konvo-platform monorepo)
# =============================================================================

# Dependencies (resolved via pnpm; reproduced from pnpm-lock.yaml)
node_modules/
.pnpm-store/
.pnp.*

# Build output
# - apps/web/dist            (Vite production bundle)
# - apps/api/dist            (TypeScript compiled output)
# - packages/*/dist          (Workspace package builds)
**/dist/
**/build/
**/.turbo/
**/.vite/
**/.next/
**/.nuxt/

# TypeScript incremental build state
*.tsbuildinfo
**/tsconfig.tsbuildinfo

# Vitest / coverage
coverage/
**/coverage/
.nyc_output/

# Playwright (e2e/)
e2e/test-results/
e2e/playwright-report/
e2e/blob-report/
e2e/.last-run.json
playwright-report/
test-results/
blob-report/

# Lighthouse / playwright-lighthouse output
lighthouse-report*.html
lighthouse-report*.json

# =============================================================================
# Environment / secrets
# =============================================================================

# Local environment overrides — committed `.env.example` is the canonical
# template for `apps/api/.env`; never commit a populated `.env` file.
.env
.env.*
!.env.example
!.env.example.*
**/.env
**/.env.*
!**/.env.example

# Secrets dropped during dev (private keys, kubeconfigs, etc.)
*.pem
*.key
*.crt
*.p12
*.pfx
secrets/
.secrets/

# =============================================================================
# Infrastructure / runtime
# =============================================================================

# docker-compose state and overrides
infra/.data/
infra/data/
infra/postgres-data/
infra/minio-data/
infra/redis-data/
docker-compose.override.yml

# Local volumes mounted by infra/docker-compose.yml
*.pgdata/
*.miniodata/

# Caddy / coturn / livekit transient state
infra/caddy/data/
infra/caddy/config/

# Lock files for tooling that run inside docker
infra/*/.lockfile

# =============================================================================
# Logs / debug output
# =============================================================================

*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Heap snapshots / profiling
*.heapsnapshot
*.cpuprofile
*.heapprofile

# =============================================================================
# Editor / OS
# =============================================================================

.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

.idea/
.vscode/
*.swp
*.swo
*~
.history/

# =============================================================================
# Kiro spec / agent workflow artefacts
# =============================================================================

# The .kiro/ tree holds spec drafts, task graphs, and agent-state JSON
# generated during local development. None of it is part of the runtime
# build, and several files contain ephemeral state that should not enter
# version control.
.kiro/

# =============================================================================
# Generated documentation / reports (transient)
# =============================================================================

# Generated typedoc / api-extractor output (committed reports go under docs/)
api-extractor.report.md.tmp
typedoc-out/

# =============================================================================
# Legacy (Django prototype archived under legacy/) — keep these so the legacy
# tree's Python build artefacts don't enter version control if anyone happens
# to run the prototype.
# =============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
develop-eggs/
downloads/
eggs/
.eggs/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
cover/

# Translations
*.mo
*.pot

# Django stuff:
local_settings.py
db.sqlite3
db.sqlite3-journal

# Flask stuff:
instance/
.webassets-cache

# Sphinx documentation
docs/_build/

# Jupyter Notebook
.ipynb_checkpoints

# IPython
profile_default/
ipython_config.py

# Environments (Python)
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# mypy / type checkers
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.pdm.toml
__pypackages__/
