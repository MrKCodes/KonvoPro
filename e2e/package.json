  },
  "devDependencies": {
    "@konvo/crypto": "workspace:*",
    "@konvo/protocol": "workspace:*",
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.1",
    "@types/ws": "^8.5.12",
    "lighthouse": "11.7.1",
    "playwright-lighthouse": "4.0.0",
    "typescript": "^5.6.3",
    "ws": "^8.18.0"
  }
}
